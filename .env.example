# PostgreSQL connection used only by superlogin/start.js
DATABASE_URL=postgresql://usuario:senha@localhost:5432/asterics_usage
DATABASE_SSL=false
# Optional bearer token for the usage API. Keep empty for local development.
USAGE_API_TOKEN=
# Optional AI analysis provider configuration for superlogin/start.js.
# Store the real key in .env (ignored by git), never in source files.
PEDAGOGICAL_AI_PROVIDER=gemini
PEDAGOGICAL_AI_API_KEY=
PEDAGOGICAL_AI_MODEL=gemini-3.8-flash
# Optional custom endpoint; leave empty to use the provider default.
PEDAGOGICAL_AI_API_URL=
